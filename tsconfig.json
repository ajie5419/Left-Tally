{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@web/*": ["apps/web/src/*"],
      "@api/*": ["apps/api/src/*"],
      "@gc/contracts": ["packages/contracts/src/index.ts"]
    }
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.vue",
    "packages/**/*.ts",
    "tests/**/*.ts",
    "config/**/*.ts"
  ],
  "exclude": ["node_modules", "**/dist"]
}
