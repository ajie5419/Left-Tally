{
  "name": "grand-comptroller",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "10.28.2"
  },
  "scripts": {
    "check:types": "vue-tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p tsconfig.json",
    "check:lint": "eslint apps packages tests scripts config --max-warnings 0",
    "check:format": "prettier --check apps packages tests scripts config .github/workflows package.json pnpm-workspace.yaml tsconfig.json eslint.config.mjs .prettierrc.json",
    "check:dependencies": "node scripts/dependencies.mjs",
    "check:source": "node scripts/source.mjs",
    "check:lockfile": "pnpm install --frozen-lockfile --lockfile-only --offline --store-dir .tools/pnpm-store",
    "check:static": "node scripts/static.mjs",
    "test:unit": "rtk vitest run tests/unit --config config/vitest.config.ts --reporter=verbose --reporter=json --outputFile=evidence/bootstrap/unit-results.json",
    "test:integration": "node scripts/database.mjs && node scripts/business-check.mjs",
    "check:migrations": "node scripts/migrations.mjs",
    "test:e2e": "node scripts/browser-server.mjs",
    "check:gate": "node scripts/gate.mjs --results evidence/bootstrap/verify/results.json",
    "test:negative": "node scripts/negative.mjs",
    "db:generate": "prisma generate --config config/prisma.config.ts",
    "build": "pnpm db:generate && vite build --config apps/web/vite.config.ts && tsc -p apps/api/tsconfig.build.json",
    "start:api": "node apps/api/dist/apps/api/src/server.js",
    "db:deploy": "prisma migrate deploy --config config/prisma.config.ts",
    "bootstrap:admin": "node scripts/bootstrap-admin.mjs",
    "test:local-auth": "node scripts/local-auth-check.mjs",
    "demo:b01": "node scripts/demo-b01.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@gc/contracts": "workspace:*",
    "@playwright/test": "1.58.2",
    "@types/node": "24.10.9",
    "@vitejs/plugin-vue": "6.0.4",
    "@vue/compiler-dom": "3.5.42",
    "@vue/compiler-sfc": "3.5.42",
    "eslint": "9.39.2",
    "eslint-plugin-vue": "10.7.0",
    "globals": "16.5.0",
    "hono": "4.13.7",
    "mysql2": "3.16.1",
    "postcss": "8.5.29",
    "prettier": "3.8.1",
    "prisma": "7.10.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.54.0",
    "vite": "7.3.1",
    "vitest": "3.2.4",
    "vue-eslint-parser": "10.2.0",
    "vue-tsc": "3.2.4"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "mariadb": "3.4.5"
  }
}
